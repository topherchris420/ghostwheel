{
    "name": "ghostwheel-gw01",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
        "build": "tsc -b && vite build",
        "preview": "vite preview --host 127.0.0.1 --port 1420 --strictPort",
        "tauri": "tauri",
        "desktop:dev": "node scripts/desktop.mjs dev",
        "desktop:build": "node scripts/desktop.mjs build",
        "format": "prettier --write \"src/**/*.{ts,tsx,css}\" index.html vite.config.ts \"tsconfig*.json\"",
        "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" index.html vite.config.ts \"tsconfig*.json\""
    },
    "dependencies": {
        "@fontsource/barlow-condensed": "^5.3.0",
        "@fontsource/dm-sans": "^5.3.0",
        "@fontsource/ibm-plex-mono": "^5.3.0",
        "@tauri-apps/api": "^2.9.0",
        "lucide-react": "^0.468.0",
        "react": "^19.0.0",
        "react-dom": "^19.0.0"
    },
    "devDependencies": {
        "@tauri-apps/cli": "^2.9.0",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "@vitejs/plugin-react": "^4.3.4",
        "prettier": "3.9.10",
        "typescript": "~5.7.2",
        "vite": "^6.0.5"
    }
}
