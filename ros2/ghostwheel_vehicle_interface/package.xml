<?xml version="1.0"?>
<package format="3">
  <name>ghostwheel_vehicle_interface</name>
  <version>0.1.0</version>
  <description>Autoware simulation interface and read-only vehicle telemetry monitor.</description>
  <maintainer email="93827718+topherchris420@users.noreply.github.com">Vers3Dynamics</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>autoware_vehicle_msgs</depend>
  <depend>autoware_control_msgs</depend>
  <depend>std_srvs</depend>
  <exec_depend>pacmod3_msgs</exec_depend>
  <!-- Dataspeed adapter is conditionally built only with native vendor types.
       Do not introduce local look-alike message types for live ROS topics. -->
  <export><build_type>ament_cmake</build_type></export>
</package>
